# -----------------------------------------------------------------------------
# Socratic AI Engineering Trainer Environment Configuration
# Copy this file to '.env' and fill in your values.
# -----------------------------------------------------------------------------

# [REQUIRED] Google Gemini API Key
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] LangSmith Tracing Configuration
# If configured, runs will be traced to LangSmith. If left empty,
# the trainer falls back to local SQLite trace logging.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=socratic-trainer
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
